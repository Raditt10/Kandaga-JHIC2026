generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext(schema: "public"), pgcrypto(schema: "public")]
}

enum Role {
  Student
  Teacher
  Company
  Admin
  BKK
}

model Users {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @map("username")
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  status       String   @default("aktif")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  role         Role     @default(Student)
  avatarUrl    String?

  studentProfile          Student?
  teacherProfile          Teacher?
  companyProfile          Company?
  verifiedCompanies       Company[]        @relation("CompanyVerifiedBy")
  reviewedProjectss       Projects[]           @relation("ProjectsReviewedBy")
  awardedBadges           ProjectsBadge[]      @relation("BadgeAwardedBy")
  reviewedContactRequests ContactRequests[] @relation("ContactRequestReviewedBy")
  recordedPartnerships    Partnerships[]    @relation("PartnershipRecordedBy")
  notifications           Notifications[]
  auditLogs               AuditLogs[]
  faqAsker                FAQs[]            @relation("FAQSAsker")
  faqReplier              FAQs[]            @relation("FAQsReplier")

  @@map("users")
}

model Major {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  fullName    String
  image       String
  link        String
  description String
  students    Student[]
  teachers    Teacher[]

  @@map("majors")
}

model Student {
  userId        String  @id @map("user_id") @db.Uuid
  majorId       String  @map("major_id") @db.Uuid
  nis           String? @unique
  class         String  
  generation    Int?    @db.SmallInt
  status        String  @default("aktif")
  bio           String?
  currentCareer String?
  photoUrl      String? @map("photo_url")

  user     Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  major    Major      @relation(fields: [majorId], references: [id])
  projects Projects[]

  @@index([majorId], map: "students_majors_idx")
  @@map("students")
}

model Teacher {
  userId  String  @id @map("user_id") @db.Uuid
  majorId String  @map("majors_id") @db.Uuid
  nip     String? @unique
  bio     String?

  user             Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  major            Major      @relation(fields: [majorId], references: [id])
  advisedProjects Projects[]  @relation("ProjectsAdvisor")

  @@index([majorId], map: "teachers_majors_idx")
  @@map("teachers")
}

model Company {
  userId             String    @id @map("user_id") @db.Uuid
  name               String    @map("username")
  field              String?   @map("field")
  description        String?   @map("description") @db.Text
  address            String?   @map("address") @db.Text
  city               String?   @map("city")
  province           String?   @map("province")
  phone              String?   @map("phone")
  website            String?   @map("website")
  nib                String?   @map("nib")
  npwp               String?   @map("npwp")
  employeeCount      String?   @map("employee_count")
  foundedYear        Int?      @map("founded_year") @db.SmallInt
  logoUrl            String?   @map("logo_url")
  picName            String?   @map("pic_name")
  picPosition        String?   @map("pic_position")
  picEmail           String?   @map("pic_email")
  picPhone           String?   @map("pic_phone")
  documentUrl        String?   @map("document_url")
  verificationStatus String    @default("pending") @map("verification_status")
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz
  catatanVerifikasi  String?   @map("catatan_verifikasi")

  user            Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier        Users?            @relation("CompanyVerifiedBy", fields: [verifiedBy], references: [id])
  contactRequests ContactRequests[]
  bookmarks       Bookmarks[]

  @@map("companies")
}

enum ProjectType {
  RPL
  TKJ
  KA
}

model SkillTool {
  id            Int        @id @default(autoincrement()) @db.SmallInt
  name          String     @unique @map("username")
  ProjectsTools ProjectsTool[]

  @@map("tools_skills")
}

model Badges {
  id             Int         @id @default(autoincrement()) @db.SmallInt
  name           String      @unique @map("badge_name")
  tier           String      @unique
  projectBadges  ProjectsBadge[]

  @@map("badges")
}

model Projects {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId    String                   @map("students_id") @db.Uuid
  advisorId    String?                  @map("teacher_advisors_id") @db.Uuid
  type         ProjectType              @map("project_types")
  title        String
  description  String?
  year         Int                      @db.SmallInt
  status       String                   @default("pending")
  coverImage   String?                  @map("cover_image")
  reviewNotes  String?                  @map("review_notes")
  reviewedBy   String?                  @map("reviewed_by") @db.Uuid
  publishedAt  DateTime?                @map("published_at") @db.Timestamptz
  viewCount    Int                      @default(0) @map("view_count")
  stars        Int                      @default(0)
  deletedAt    DateTime?                @map("deleted_at") @db.Timestamptz
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  searchVector Unsupported("tsvector")? @map("search_vector")
  isPrivate    Boolean                  @default(false)

  student         Student           @relation(fields: [studentId], references: [userId])
  advisor         Teacher?            @relation("ProjectsAdvisor", fields: [advisorId], references: [userId])
  reviewer        Users?            @relation("ProjectsReviewedBy", fields: [reviewedBy], references: [id])
  media           ProjectsMedia[]
  tools           ProjectsTool[]
  badges          ProjectsBadge[]
  contactRequests ContactRequests[]
  bookmarks       Bookmarks[]
  mainFeatures    ProjectsMainFeatures[]

  @@index([studentId], map: "projects_students_idx")
  @@index([advisorId], map: "projects_advisors_idx")
  @@index([searchVector], type: Gin)
  @@map("projects")
}

model ProjectsMainFeatures {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  feature   String
  
  project Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, feature])
  @@map("projects_main_features")
}

model ProjectsMedia {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  url       String
  type      String @default("photo") @map("mediatype")
  order     Int?   @default(0) @map("orders") @db.SmallInt

  project Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@map("projects_media")
}

model ProjectsTool {
  projectId String @map("project_id") @db.Uuid
  toolId    Int    @map("tool_id") @db.SmallInt
  name      String @map("tool_name")

  project Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tool    SkillTool @relation(fields: [toolId], references: [id])

  @@id([projectId, toolId])
  @@map("project_tools")
}

model ProjectsBadge {
  projectId String   @map("project_id") @db.Uuid
  badgeId   Int      @map("badge_id") @db.SmallInt
  awardedBy String   @map("awarded_from") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz

  project Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  badge   Badges    @relation(fields: [badgeId], references: [id])
  awarder Users     @relation("BadgeAwardedBy", fields: [awardedBy], references: [id])

  @@id([projectId, badgeId])
  @@index([badgeId], map: "projects_badge_idx")
  @@map("projects_badge")
}

model ContactRequests {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  purpose     String  
  message     String   
  status      String    @default("sent")
  bkkNotes    String?   @map("bkk_notes")
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [userId])
  project     Projects     @relation(fields: [projectId], references: [id])
  reviewer    Users?        @relation("ContactRequestReviewedBy", fields: [reviewedBy], references: [id])
  partnership Partnerships?

  @@index([status], map: "pk_status_idx")
  @@index([companyId], map: "pk_companies_idx")
  @@index([projectId], map: "pk_projects_idx")
  @@map("contact_requests")
}

model Bookmarks {
  companyId  String   @map("company_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [userId], onDelete: Cascade)
  project    Projects    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([companyId, projectId])

  @@map("bookmarks")
}

model Partnerships {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId  String    @unique @map("request_id") @db.Uuid
  type       String    
  startDate  DateTime? @map("start_date") @db.Date
  notes      String?
  isVerified String    @default("pending")
  recordedBy String    @map("recorded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  contactRequest ContactRequests @relation(fields: [requestId], references: [id])
  recorder       Users           @relation("PartnershipRecordedBy", fields: [recordedBy], references: [id])
  @@map("partnerships")
}

model Notifications {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   
  title     String   
  content   String   
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead], map: "notification_user_idx")
  @@map("notifications")
}

model AuditLogs {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   
  entity    String   
  entityId  String?  @map("entity_id")
  data      Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user Users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId], map: "audit_entity_idx")
  @@index([createdAt], map: "audit_time_idx")
  @@map("audit_logs")
}

model FAQs {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  askerId   String   @map("asker_id") @db.Uuid
  replierId String   @map("replier_id") @db.Uuid
  question  String
  answer    String
  
  asker     Users    @relation("FAQSAsker", fields: [askerId], references: [id])
  replier   Users    @relation("FAQsReplier", fields: [replierId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  
  @@map("faqs")
}

model InternshipApplication {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicantType String    @map("applicant_type")
  status         String    @default("pending")
  studentId      String?   @map("student_id") @db.Uuid
  studentName    String?   @map("student_name")
  studentClass   String?   @map("student_class")
  nis            String?
  major          String?
  cvUrl          String?   @map("cv_url")
  portfolioUrl   String?   @map("portfolio_url")
  companyId      String?   @map("company_id") @db.Uuid
  companyName    String    @map("company_name")
  companyField   String?   @map("company_field")
  companyAddress String?   @map("company_address")
  contactPerson  String?   @map("contact_person")
  positionTitle  String    @map("position_title")
  requiredMajor  String?   @map("required_major")
  quota          Int?      @default(1)
  description    String
  requirements   String?
  stipend        String?
  durationMonths Int       @default(3) @map("duration_months")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  contactEmail   String    @map("contact_email")
  contactPhone   String    @map("contact_phone")
  bkkNotes       String?   @map("bkk_notes")
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("internship_applications")
}